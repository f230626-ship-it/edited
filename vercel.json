{
  "buildCommand": "npm run build:vercel",
  "framework": "nextjs",
  "installCommand": "npm install",
  "env": {
    "NODE_OPTIONS": "--max-old-space-size=4096"
  },
  "crons": [
    {
      "path": "/api/cron/icp-filters",
      "schedule": "0 4 * * 6"
    },
    {
      "path": "/api/cron/projects-sheet",
      "schedule": "0 4 1,15 * *"
    },
    {
      "path": "/api/cron/payroll-reminder",
      "schedule": "0 4 * * *"
    }
  ]
}
