{
  "buildCommand": "npm run build:vercel",
  "framework": "nextjs",
  "installCommand": "npm install",
  "env": {
    "NODE_OPTIONS": "--max-old-space-size=4096"
  },
  "crons": [
    {
      "path": "/api/cron/icp-filters",
      "schedule": "0 4 * * 6"
    },
    {
      "path": "/api/cron/projects-sheet",
      "schedule": "0 4 1,15 * *"
    },
    {
      "path": "/api/cron/linkedin-weekly-reminder",
      "schedule": "0 10 * * 3"
    },
    {
      "path": "/api/cron/linkedin-followup-reminder",
      "schedule": "0 10 * * 4"
    },
    {
      "path": "/api/cron/monthly-report",
      "schedule": "0 9 * * 1-5"
    },
    {
      "path": "/api/cron/payroll-reminder",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/cron/sync-standups",
      "schedule": "0 9,13,18 * * 1-5"
    },
    {
      "path": "/api/cron/linkedin-test-reminder",
      "schedule": "30 15 13 8 *"
    },
    {
      "path": "/api/cron/linkedin-test-followup",
      "schedule": "30 16 13 8 *"
    }
  ]
}
